[TEMPLATE]
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/ramnagar-eats
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

SERVICE_CENTER_LAT=32.80674
SERVICE_CENTER_LNG=75.314854
# Seeds the initial delivery radius; the admin can change it live from the admin panel.
SERVICE_RADIUS_KM=15

# --- Email OTP (Brevo) ---
# REQUIRED for email OTP — Brevo transactional API key (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Delivery: console | smtp | brevo. Auto-detects when credentials are set.
OTP_DELIVERY=smtp
EMAIL_FROM="Ramnagar Eats <noreply@yourdomain.com>"
# console = dev fallback (prints codes to the log). Use brevo in production.
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Google OAuth ---
# OAuth web client (redirect URI: <PUBLIC_API_URL>/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=https://api.yourdomain.com
CUSTOMER_WEB_URL=https://customer.yourdomain.com
RESTAURANT_WEB_URL=https://restaurant.yourdomain.com

# --- Branding (display-only, consumed via GET /api/v1/config) ---
BRAND_NAME=Ramnagar Eats
CURRENCY_SYMBOL=₹
ORDER_PREFIX=RE-

# --- Pricing (always enforced server-side) ---
BASE_DELIVERY_FEE=20
DELIVERY_FEE_FREE_ABOVE=499

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Image uploads (ImageKit CDN) ---
# Without these, uploads fall back to the local /uploads dir (ephemeral on Render).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Routing (Mapbox Directions, optional) ---
# Road-route polyline on the order tracking map. When empty, a geodesic fallback is used.
MAPBOX_ACCESS_TOKEN=
