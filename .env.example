[TEMPLATE]
# --- Environment ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ramnagar-eats
JWT_SECRET=replace-with-a-long-random-secret-in-production

# --- Service area (hyperlocal) ---
SERVICE_CENTER_LAT=32.80674
SERVICE_CENTER_LNG=75.314854
SERVICE_RADIUS_KM=15

# --- Branding (display-only, consumed via GET /api/v1/config) ---
BRAND_NAME=Ramnagar Eats
CURRENCY_SYMBOL=₹
ORDER_PREFIX=RE-

# --- Pricing (always enforced server-side) ---
BASE_DELIVERY_FEE=20
DELIVERY_FEE_FREE_ABOVE=499

# --- Security (production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Email OTP login ---
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ramnagar Eats <noreply@yourdomain.com>"
OTP_DELIVERY=smtp
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:5000
CUSTOMER_WEB_URL=http://localhost:3000
RESTAURANT_WEB_URL=http://localhost:3001

# --- Image uploads (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Maps ---
# Base tiles for every embedded map (OSM `{z}/{x}/{y}` template). Both default
# to OpenStreetMap, so maps render with no credentials at all — set these to
# move to a commercial tile host. Markers and route lines are our own data and
# never need a maps key.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# --- Routing & geocoding (both optional) ---
# Road routing (route geometry + travel time) for live delivery tracking. Leave
# empty to fall back to a straight geodesic line: orders, ETAs and dashboards
# work either way, only the route shape is less precise.
MAPBOX_ACCESS_TOKEN=

# Reverse geocoding for the location pickers. Defaults to OpenStreetMap's
# Nominatim; point this at your own instance before heavy production traffic.
GEOCODER_BASE_URL=


# --- Web Push notifications (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ramnagareats.test
