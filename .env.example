[TEMPLATE]
# --- Environment ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ramnagar-eats
JWT_SECRET=replace-with-a-long-random-secret-in-production

# --- Service area (hyperlocal) ---
SERVICE_CENTER_LAT=19.076
SERVICE_CENTER_LNG=72.8777
# Default delivery radius. The ADMIN can change it live from the admin panel
# (stored in MongoDB) — this env value only seeds the initial setting.
SERVICE_RADIUS_KM=10

# --- Pricing (always enforced server-side) ---
BASE_DELIVERY_FEE=20
DELIVERY_FEE_FREE_ABOVE=499

# --- Security (production) ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# General API limit: requests per window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter limit for /auth routes (login/register attempts per window per IP).
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Email OTP login ---
# Delivery: console (dev — code printed to log + shown in the UI) or brevo (real email).
# Brevo is used automatically when BREVO_API_KEY is set; OTP_DELIVERY=console forces the fallback.
BREVO_API_KEY=
EMAIL_FROM="Ramnagar Eats <noreply@ramnagareats.test>"
OTP_DELIVERY=console
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials (OAuth client, Web app).
# Authorized redirect URI must be: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the backend is reachable for the OAuth redirect (defaults to localhost:5000).
PUBLIC_API_URL=http://localhost:5000
# Frontend origins the OAuth callback redirects back to.
CUSTOMER_WEB_URL=http://localhost:3000
RESTAURANT_WEB_URL=http://localhost:3001

# --- Image uploads (ImageKit) ---
# Uploads use the ImageKit CDN when all three keys are set; otherwise images are
# stored on local disk and served by the API from /uploads (fine for local dev).
# Create a free account at https://imagekit.io — keys live under Developer → API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
