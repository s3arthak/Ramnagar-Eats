[TEMPLATE]
# --- Environment ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ramnagar-eats
JWT_SECRET=replace-with-a-long-random-secret-in-production

# --- Service area (hyperlocal) ---
SERVICE_CENTER_LAT=32.80674
SERVICE_CENTER_LNG=75.314854
SERVICE_RADIUS_KM=15

# --- Branding (display-only, consumed via GET /api/v1/config) ---
BRAND_NAME=Ramnagar Eats
CURRENCY_SYMBOL=₹
ORDER_PREFIX=RE-

# --- Pricing (always enforced server-side) ---
BASE_DELIVERY_FEE=20
DELIVERY_FEE_FREE_ABOVE=499

# --- Security (production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Email OTP login ---
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ramnagar Eats <noreply@yourdomain.com>"
OTP_DELIVERY=smtp
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:5000
CUSTOMER_WEB_URL=http://localhost:3000
RESTAURANT_WEB_URL=http://localhost:3001

# --- Image uploads (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Google Maps Platform ---
# Frontend key (Maps JavaScript API) — restrict to HTTP referrers in Google Cloud Console
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Backend key (Routes API) — restrict to server IPs in Google Cloud Console
GOOGLE_MAPS_SERVER_KEY=

# Backend key (Geocoding API) — restrict to server IPs in Google Cloud Console
GOOGLE_MAPS_GEOCODING_KEY=

# Backend key (Places API) — restrict to server IPs in Google Cloud Console
GOOGLE_MAPS_PLACES_KEY=

# Legacy Mapbox support (optional, can be removed after full Google Maps migration)
MAPBOX_ACCESS_TOKEN=

# --- Web Push notifications (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ramnagareats.test
