{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "test:api": "cross-env NODE_ENV=test tsx scripts/api-test.ts"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
