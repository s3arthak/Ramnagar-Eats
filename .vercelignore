# Keep Vercel CLI deploys lean. Deploys run from the repo root with the
# project's rootDirectory pointing at apps/* — only shared/ (imported by the
# apps' CSS) and the app dirs are needed at build time.
node_modules
.git
.github
backend
docs
data
docker
scripts
*.log
.env*
!.env.example
!.env.production.example
**/dist
**/node_modules
**/.vercel
